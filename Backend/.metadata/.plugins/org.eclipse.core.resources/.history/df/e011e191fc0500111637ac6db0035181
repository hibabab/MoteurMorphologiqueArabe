package ProjetMorphologieAlgo;

public class ABRTree {
    private ABRNode root;

   
    public void insert(Racine r) {
        root = insertRec(root, r);
    }

    private ABRNode insertRec(ABRNode node, Racine r) {
        if (node == null) return new ABRNode(r);

        if (r.getLettres().compareTo(node.racine.getLettres()) < 0)
            node.left = insertRec(node.left, r);
        else
            node.right = insertRec(node.right, r);

        return node;
    }

    public ABRNode getRoot() {
        return root;
    }
    public Racine search(String lettres) {
        ABRNode curr = root;
        while (curr != null) {
            int c = lettres.compareTo(curr.racine.getLettres());
            if (c == 0) return curr.racine;
            curr = c < 0 ? curr.left : curr.right;
        }
        return null;
    }
    public boolean exists(String lettres) {
        ABRNode curr = root;
        while (curr != null) {
            int c = lettres.compareTo(curr.racine.getLettres());
            if (c == 0) return true; // Trouvé
            curr = c < 0 ? curr.left : curr.right;
        }
        return false; // Non trouvé
    }
    
    
 // 2. Fonction qui affiche toutes les racines
    public void afficherToutesRacines() {
        if (root == null) {
            System.out.println("L'arbre est vide.");
            return;
        }
        
        System.out.println("=== Liste de toutes les racines ===");
        afficherInfixe(root);
        System.out.println("====================================");
    }
    
    // Parcours infixe pour afficher dans l'ordre alphabétique
    private void afficherInfixe(ABRNode node) {
        if (node != null) {
            afficherInfixe(node.left);
            System.out.println("- " + node.racine.getLettres());
            afficherInfixe(node.right);
        }
    }
}

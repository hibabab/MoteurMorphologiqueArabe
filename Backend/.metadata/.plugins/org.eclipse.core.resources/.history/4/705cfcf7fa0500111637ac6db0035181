package ProjetMorphologieAlgo;

import java.util.*;

public class HashTable {
    private HashMap<String, List<String>> table;
    
    public HashTable() {
        table = new HashMap<>();
        genererSchemesAutomatique();
    }
    
    private void genererSchemesAutomatique() {
        // Liste des schèmes à générer automatiquement
        String[] schemes = {
            "فاعل", "مفعول", "افتعل", "مفعال", 
            "تفاعل", "انفعل", "مفعل", "مفعلة"
        };
        
        for (String scheme : schemes) {
            String regle = analyserScheme(scheme);
            List<String> regles = new ArrayList<>();
            regles.add(regle);
            table.put(scheme, regles);
        }
    }
    
    private String analyserScheme(String scheme) {
        StringBuilder regle = new StringBuilder();
        
        for (char lettre : scheme.toCharArray()) {
            switch (lettre) {
                case 'ف':
                    regle.append("V[0]");
                    break;
                case 'ع':
                    regle.append("V[1]");
                    break;
                case 'ل':
                    regle.append("V[2]");
                    break;
                default:
                    regle.append(lettre);
            }
        }
        
        return regle.toString();
    }
    
    // Transformation avec un seul schème
    public String transformer(String verbe, String scheme) {
        if (verbe.length() < 3) return "";
        
        List<String> regles = table.get(scheme);
        if (regles == null) return "";
        
        String regle = regles.get(0);
        return regle
            .replace("V[0]", verbe.substring(0, 1))
            .replace("V[1]", verbe.substring(1, 2))
            .replace("V[2]", verbe.substring(2, 3));
    }
    
    // NOUVELLE MÉTHODE : Transformation avec plusieurs schèmes
    public List<String> transformer(String verbe, String[] schemes) {
        List<String> resultats = new ArrayList<>();
        
        if (verbe == null || verbe.length() < 3) {
            System.err.println("Le verbe doit contenir au moins 3 lettres");
            return resultats;
        }
        
        for (String scheme : schemes) {
            List<String> regles = table.get(scheme);
            
            if (regles != null) {
                // Appliquer chaque règle du schème
                for (String regle : regles) {
                    String forme = regle
                        .replace("V[0]", verbe.substring(0, 1))
                        .replace("V[1]", verbe.substring(1, 2))
                        .replace("V[2]", verbe.substring(2, 3));
                    resultats.add(forme);
                }
            } else {
                System.out.println("Schème non trouvé : " + scheme);
            }
        }
        
        return resultats;
    }
    
    public void afficherTous() {
        System.out.println("=== Schèmes disponibles ===");
        for (String scheme : table.keySet()) {
            System.out.println(scheme + " → " + table.get(scheme));
        }
    }
    
    // Getters utiles
    public Set<String> getSchemesDisponibles() {
        return table.keySet();
    }
    
    public boolean contientScheme(String scheme) {
        return table.containsKey(scheme);
    }
    
    // Méthode pour tester
    public static void main(String[] args) {
        HashTable ht = new HashTable();
        ht.afficherTous();
        
        System.out.println("\n=== Test avec plusieurs schèmes ===");
        String verbe = "كتب";
        String[] mesSchemes = {"فاعل", "مفعول", "افتعل", "غيرموجود"};
        
        System.out.println("Verbe de base : " + verbe);
        System.out.println("Schèmes à appliquer : " + Arrays.toString(mesSchemes));
        
        List<String> formes = ht.transformer(verbe, mesSchemes);
        System.out.println("\nFormes dérivées :");
        for (int i = 0; i < formes.size(); i++) {
            System.out.println((i + 1) + ". " + formes.get(i));
        }
        
        System.out.println("\n=== Test avec d'autres verbes ===");
        
        // Test avec un autre verbe
        String verbe2 = "درس";
        String[] schemes2 = {"فاعل", "مفعال", "مفعل"};
        
        List<String> formes2 = ht.transformer(verbe2, schemes2);
        System.out.println("Verbe : " + verbe2);
        System.out.println("Formes : " + formes2);
    }
}
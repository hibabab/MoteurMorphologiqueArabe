package ProjetMorphologieAlgo;

import java.io.*;
import java.util.Arrays;
import java.util.List;

public class TraitementTextuel {
    
    public static void traiterFichier(String nomFichier) {
        // Initialiser structures
        ABRTree arbre = new ABRTree();
        HashTable table = new HashTable();
        
        System.out.println("=== Lecture du fichier: " + nomFichier + " ===");
        
        // 1. Lire le fichier et remplir l'arbre
        try {
            BufferedReader lecteur = new BufferedReader(new FileReader(nomFichier));
            String ligne;
            int count = 0;
            while ((ligne = lecteur.readLine()) != null) {
                ligne = ligne.trim();
                if (ligne.length() >= 3) { // verbe de 3 lettres minimum
                    arbre.insert(new Racine(ligne));
                    count++;
                }
            }
            lecteur.close();
            System.out.println(count + " verbes ajoutés à l'arbre.");
        } catch (IOException e) {
            System.out.println("Problème avec le fichier: " + e.getMessage());
            return;
        }
        
        System.out.println("\n=== Test des structures ===");
        
        // 2. Afficher les schèmes disponibles
        table.afficherTous();
        
        // 3. Afficher toutes les racines de l'arbre
        System.out.println("\n=== Racines dans l'arbre ===");
        arbre.afficherToutesRacines();
        
        // 4. Tester quelques transformations sur des racines spécifiques
        System.out.println("\n=== Transformations de test ===");
        
        // Test avec quelques racines spécifiques
        String[] racinesTest = {"كتب", "درس", "فعل"};
        String[] schemes = {"فاعل", "مفعول", "افتعل"};
        
        for (String racine : racinesTest) {
            System.out.println("\n--- Racine: " + racine + " ---");
            
            // Vérifier si la racine existe dans l'arbre
            boolean existe = arbre.exists(racine);
            System.out.println("Dans l'arbre: " + existe);
            
            if (existe) {
                // Transformer avec plusieurs schèmes
                List<String> formes = table.transformer(racine, schemes);
                System.out.println("Formes dérivées:");
                for (int i = 0; i < formes.size(); i++) {
                    System.out.println("  " + (i+1) + ". " + formes.get(i));
                }
            }
        }
        
        System.out.println("\n=== Test de recherche dans l'arbre ===");
        
        // 5. Tester la recherche dans l'arbre
        String[] recherches = {"كتب", "قرأ", "فعل", "غيرموجود"};
        
        for (String recherche : recherches) {
            Racine trouve = arbre.search(recherche);
            if (trouve != null) {
                System.out.println("Trouvé: " + trouve.getLettres());
            } else {
                System.out.println("Non trouvé: " + recherche);
            }
        }
    }
    
    // Méthode pour tester
    public static void main(String[] args) {
        // Chemin spécifique à votre projet
        String cheminFichier = "C:\\Users\\qsqsq\\OneDrive\\Bureau\\ProjetAlgo\\ProjetMorphologie\\src\\ProjetMorphologieAlgo\\verbes.txt";
        
        // Exécuter le traitement complet
        traiterFichier(cheminFichier);
        
        System.out.println("\n\n=== Test indépendant de HashTable ===");
        
        // Test séparé de HashTable
        HashTable ht = new HashTable();
        ht.afficherTous();
        
        System.out.println("\n=== Test avec plusieurs schèmes ===");
        String verbe = "كتب";
        String[] mesSchemes = {"فاعل", "مفعول", "افتعل", "غيرموجود"};
        
        System.out.println("Verbe de base : " + verbe);
        System.out.println("Schèmes à appliquer : " + Arrays.toString(mesSchemes));
        
        List<String> formes = ht.transformer(verbe, mesSchemes);
        System.out.println("\nFormes dérivées :");
        for (int i = 0; i < formes.size(); i++) {
            System.out.println((i + 1) + ". " + formes.get(i));
        }
        
        System.out.println("\n=== Test avec d'autres verbes ===");
        
        // Test avec un autre verbe
        String verbe2 = "درس";
        String[] schemes2 = {"فاعل", "مفعال", "مفعل"};
        
        List<String> formes2 = ht.transformer(verbe2, schemes2);
        System.out.println("Verbe : " + verbe2);
        System.out.println("Formes : " + formes2);
    }
}